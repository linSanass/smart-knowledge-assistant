# 复制为 backend/.env 后填入真实值

# DeepSeek API Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MySQL 连接串（SQLAlchemy + PyMySQL）
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/smart_ai_assistant?charset=utf8mb4

# Redis（可选，未配置时自动降级为不使用缓存）
REDIS_URL=redis://127.0.0.1:6379/0

# 缓存有效期（秒），只作用于 knowledge_search 的检索结果
CACHE_TTL=300
